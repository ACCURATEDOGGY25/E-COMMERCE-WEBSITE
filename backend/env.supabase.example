# Copy these into backend/.env (or run: bash scripts/configure-supabase.sh)
#
# Supabase Dashboard → Project Settings → Database → Connect → ORMs → Prisma
#
# Replace:
#   [PROJECT-REF]  — e.g. abcdefghijklmnop (from project URL)
#   [PASSWORD]     — database password (URL-encode if it has @ # % etc.)
#   [REGION]       — e.g. us-east-1, eu-west-1

# Pooled connection (API runtime) — port 6543 + pgbouncer
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Prisma migrate / db push / seed) — port 5432
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Required — any long random string (not your Supabase password)
JWT_SECRET=[GENERATE-A-LONG-RANDOM-STRING]
