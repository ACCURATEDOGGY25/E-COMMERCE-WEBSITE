# Copy into frontend/.env.local (API URL is required; Supabase keys optional for v2)
#
# Backend API (local dev)
NEXT_PUBLIC_API_URL=http://localhost:4000

# After deploying backend (Render/Railway), use your production API URL:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# Optional — only if you add Supabase Auth on the frontend later
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-api-settings

# Optional payments / OAuth
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
